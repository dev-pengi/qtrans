{
  "name": "qtrans",
  "description": "Q trans, Installer for Qareeb translation manager",
  "version": "1.3.1",
  "license": "MIT",
  "main": "dist/server.js",
  "bin": {
    "qtrans": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "homepage": "/",
  "scripts": {
    "start": "node dist/server.js",
    "dev:server": "cross-env NODE_ENV=development node dist/server.js",
    "dev": "concurrently \"tsc -p . && yarn run dev:server\" \"cd client && yarn dev\"",
    "watch": "nodemon src/server.ts",
    "build": "tsc -p . && cd client && npm run build && cd .."
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "inquirer": "^12.2.0",
    "joi": "^17.13.3",
    "kleur": "^4.1.5",
    "ora": "5.4.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "http-proxy-middleware": "^3.0.3",
    "@types/node": "^22.10.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
