{
  "name": "qtrans",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"tsc -p .\" \"node dist/server.js\" \"cd client && yarn dev\"",
    "watch": "nodemon src/server.ts",
    "build": "tsc -p . && cd client && npm run build && cd .."
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "http-proxy-middleware": "^3.0.3",
    "joi": "^17.13.3",
    "kleur": "^4.1.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
